# Copy to .env and fill in. Every key is optional: without one, that piece falls back
# (rule-based genie, browser speech, sample matches, no AI mesh, simulated payments).

# Public HTTPS URL of the deploy. Used for QR codes so phones can reach the pledge page.
PUBLIC_URL=http://localhost:3000
PORT=3000
# 1 = Apify and Meshy serve from cache only (rehearsals cost nothing).
DEMO_MODE=0
# Protects /api/admin/* (force deadline, demo reset). Pass as ?admin=<token> or x-admin-token.
ADMIN_TOKEN=

# Design brain (Claude). BRAIN_MODEL overrides the model.
ANTHROPIC_API_KEY=
BRAIN_MODEL=claude-opus-5-5

# Voice: Ink 2 STT + Sonic TTS. The key stays on the server; browsers get short-lived tokens.
CARTESIA_API_KEY=
CARTESIA_VERSION=2026-08-14

# Match finder: our published Actor, e.g. yourname~wish-matcher
APIFY_TOKEN=
APIFY_ACTOR=

# Hero 3D model (text-to-3D preview)
MESHY_API_KEY=

# Stripe TEST mode only (sk_test_..., pk_test_...). Webhook secret from `stripe listen` or the dashboard.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Where SQLite and downloaded models live (mount a persistent disk here in production).
# DATA_DIR=./data
